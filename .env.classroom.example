# 새 교실 전용 설정입니다. 로컬 실행은 npm run dev:classroom 만으로 가능합니다.
# 이 예시를 .env.classroom.local 로 복사한 경우에도 실제 값은 커밋하지 않습니다.
CLASSROOM_MODE=local
CLASSROOM_PORT=4044
CLASSROOM_DB_PATH=.local/classroom-v2.sqlite
CLASSROOM_ALLOWED_ORIGINS=http://127.0.0.1:4043,http://localhost:4043
CLASSROOM_GITHUB_MODE=simulator
# 운영 연결 시 CLASSROOM_MODE를 local로 두지 말고 아래 항목을 환경변수로 지정합니다.
# CLASSROOM_HOST=0.0.0.0
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# CLASSROOM_GITHUB_MODE=live
# CLASSROOM_GITHUB_APP_ID=
# CLASSROOM_GITHUB_PRIVATE_KEY=
# CLASSROOM_GITHUB_WEBHOOK_SECRET=
# CLASSROOM_GITHUB_REPOSITORIES=[]
